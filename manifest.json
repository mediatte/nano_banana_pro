{
  "manifest_version": 3,
  "name": "Nano Banana Pro - AI 이미지 생성기",
  "version": "2.1.1",
  "description": "Gemini 3로 텍스트나 이미지를 고품질 AI 이미지로 변환. 프롬프트 자동 개선 및 이미지 편집 지원",
  "homepage_url": "https://mediatte.github.io/nano_banana_pro/privacy",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.allorigins.win/*"
  ],
  "action": {
    "default_title": "Nano Banana Pro 열기"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
